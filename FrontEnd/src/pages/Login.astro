---
import Header from "../components/Header";
import FormularioLogin from "../components/FormularioLogin.astro";
import Footer from "../components/Footer.astro";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="img/svg" href="/img/jacana-bg.png">
    <title>Jacana | Login</title>
</head>
<body>
    <Header client:load />
    <FormularioLogin />
    <Footer />
</body>
</html>

<script>

    import Swal from "sweetalert2";

    document.addEventListener('DOMContentLoaded', () => {
        
        const urlParams = new URLSearchParams(window.location.search);
        const redirectedFrom = urlParams.get('redirected'); 

        if (redirectedFrom) {
            Swal.fire({
                icon: 'error',
                title: 'Acceso denegado',
                text: `Debes iniciar sesión para acceder a ${redirectedFrom}.`,
                confirmButtonColor: '#d33',
            });
        }
    });

</script>