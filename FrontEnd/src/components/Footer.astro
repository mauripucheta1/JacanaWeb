<script>

    import Swal from "sweetalert2";

    document.addEventListener('DOMContentLoaded', () => {
        const inputEmail = document.querySelector('.inputRegistrar') as HTMLInputElement;
        const botonRegistrar = document.querySelector('.botonRegistrar');

        botonRegistrar.addEventListener('click', async () => {
            const email = inputEmail.value;

            if (!email || !email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
                Swal.fire({
                    icon: 'error',
                    title: 'Correo inválido',
                    text: 'Por favor, ingrese un correo válido.',
                    confirmButtonColor: '#3085d6',
                });
                return;
            }

            try {
                const response = await fetch('http://localhost:3000/clientes', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email }), 
                });

                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Registrado correctamente',
                        text: 'El correo se ha registrado exitosamente en la base de datos.',
                        confirmButtonColor: '#28a745',
                    });
                    inputEmail.value = ''; 
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error al registrar',
                        text: 'Hubo un problema al registrar el correo. Inténtelo nuevamente.',
                        confirmButtonColor: '#d33',
                    });
                }
            } catch (error) {
                console.error('Error del servidor:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error del servidor',
                    text: 'No se pudo conectar al servidor. Inténtelo más tarde.',
                    confirmButtonColor: '#d33',
                });
            }
        });
    });

</script>