<style>
    .slider {
        display: flex;
        overflow: hidden;
        width: 100%; 
    }

    .slider img {
        width: 100%;
        flex-shrink: 0;
        transition: transform 6s ease; 
        animation: slide 15s infinite;
    }

    @keyframes slide {
        0% { transform: translateX(0); }
        20% { transform: translateX(-100%); }
        40% { transform: translateX(-200%); }
        60% { transform: translateX(-300%); }
        80% {transform: translateX(-400%); }

    }


    .img-container {
        background-image: url('/img/carro-1.jfif');
        background-size: cover;
        transition: 1s ease;
    }

    .img-container:hover {
        background-image: url('/img/carro-2.jfif');
    }

    .img-container2 {
        background-image: url('/img/carro-3.jfif');
        background-size: cover;
        transition: 1s ease;
    }

    .img-container2:hover {
        background-image: url('/img/carro-4.jpg');
    }

    .avb {
        transition: transform 1s;
    }

    .avb:hover {
        transform: scale(1.04);
    }

    .backgroundLugar {
        background-image: url('/img/bg-we.jpg');
    }
</style>
