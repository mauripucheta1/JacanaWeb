---
import Panel from "../components/Panel.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="img/svg" href="/img/jacana-bg.png">
    <title>Jacana | Administración</title>
</head>
<body>
    <Panel/>
</body>
</html>

<script>

    document.addEventListener('DOMContentLoaded', () => {
        const token = sessionStorage.getItem('token');

        if (!token) {
            window.location.href = '/Login?redirected=AdminPanel';
        } else {
            console.log('Token válido: se puede acceder al panel.');
        }
    });

</script>
